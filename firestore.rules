rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("active", true) == true;
    }

    function isAdmin() {
      return hasActiveProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isMember() {
      return hasActiveProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "member";
    }

    function isAttributedToCurrentUser() {
      return request.resource.data.createdByUid is string
        && request.resource.data.createdByUid == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /admin_notifications/{notificationId} {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"])
        && request.resource.data.readBy is list;
    }

    match /vehicles/{vehicleId} {
      allow read, create, update, delete: if isAdmin();

      match /statusHistory/{historyId} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    match /reports/{reportId} {
      allow create: if hasActiveProfile()
        && isAttributedToCurrentUser()
        && request.resource.data.reportNo is string
        && request.resource.data.plate is string;
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "sourceChecklistId",
          "sourceChecklistReportNo"
        ]);
    }

    match /seccom_checklists/{reportId} {
      allow create: if isMember()
        && isAttributedToCurrentUser()
        && request.resource.data.reportType == "seccom_checklist"
        && request.resource.data.adminReviewStatus == "pending";
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "adminReviewStatus",
          "policeReportRequired",
          "adminReviewNotes",
          "adminReviewedByUid",
          "adminReviewedByName",
          "adminReviewedByEmail",
          "adminReviewedAt",
          "np299ReportId",
          "np299ReportNo",
          "np299GeneratedAt"
        ])
        && request.resource.data.get("adminReviewStatus", "pending")
          in ["pending", "escalation_required", "no_escalation"]
        && (
          resource.data.get("adminReviewStatus", "pending") == "pending"
          || request.resource.data.get("adminReviewStatus", "pending")
            == resource.data.get("adminReviewStatus", "pending")
        );
    }

    match /fuel_refuel_reports/{reportId} {
      allow create: if isMember()
        && isAttributedToCurrentUser()
        && request.resource.data.reportType == "fuel_refuel"
        && request.resource.data.get("adminFollowUpStatus", "pending") == "pending";
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "adminFollowUpStatus",
          "adminFollowUpNotes",
          "adminFollowedUpByUid",
          "adminFollowedUpByName",
          "adminFollowedUpByEmail",
          "adminFollowedUpAt"
        ])
        && request.resource.data.get("adminFollowUpStatus", "pending")
          in ["pending", "completed"]
        && (
          resource.data.get("adminFollowUpStatus", "pending") == "pending"
          || request.resource.data.get("adminFollowUpStatus", "pending")
            == resource.data.get("adminFollowUpStatus", "pending")
        );
    }

    match /iu_barcodes/{barcodeId} {
      allow read: if hasActiveProfile();
      allow write: if false;
    }
  }
}
