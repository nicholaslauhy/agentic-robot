rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("active", true) == true;
    }

    function isAdmin() {
      return hasActiveProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /deviceTokens/{deviceId} {
        allow read: if false;
        allow create, update, delete: if hasActiveProfile()
          && request.auth.uid == userId;
      }
    }

    match /admin_notifications/{notificationId} {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"])
        && request.resource.data.readBy is list;
    }

    match /reports/{reportId} {
      allow create: if hasActiveProfile();
      allow read, update, delete: if isAdmin();
    }

    match /seccom_checklists/{reportId} {
      allow create: if hasActiveProfile();
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.get("adminReviewStatus", "pending")
          in ["pending", "escalation_required", "no_escalation"]
        && (
          resource.data.get("adminReviewStatus", "pending") == "pending"
          || request.resource.data.get("adminReviewStatus", "pending")
            == resource.data.get("adminReviewStatus", "pending")
        );
    }

    match /fuel_refuel_reports/{reportId} {
      allow create: if hasActiveProfile()
        && request.resource.data.get("adminFollowUpStatus", "pending") == "pending";
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.get("adminFollowUpStatus", "pending")
          in ["pending", "completed"]
        && (
          resource.data.get("adminFollowUpStatus", "pending") == "pending"
          || request.resource.data.get("adminFollowUpStatus", "pending")
            == resource.data.get("adminFollowUpStatus", "pending")
        );
    }

    match /iu_barcodes/{barcodeId} {
      allow read: if hasActiveProfile();
      allow write: if false;
    }
  }
}
